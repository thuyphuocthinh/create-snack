{
  "id": "redis",
  "label": "Redis (cache, distributed lock, rate-limit, idempotency)",
  "default": true,
  "templates": ["nest-ddd"],
  "dependencies": {
    "ioredis": "^6.0.0"
  },
  "env": [
    "# Redis (docker-compose.yml)",
    "REDIS_HOST=localhost",
    "REDIS_PORT=6379",
    "REDIS_DB=0"
  ],
  "docker": {
    "file": "docker.service.yml",
    "volumes": ["redis_data"]
  },
  "inject": [
    {
      "file": "src/app.module.ts",
      "marker": "// @infra:imports",
      "lines": [
        "import { RedisModule } from './core/infrastructure/redis/redis.module.js';",
        "import { IdempotencyModule } from './core/infrastructure/redis/idempotency/idempotency.module.js';",
        "import { RateLimitModule } from './core/infrastructure/redis/rate-limit/rate-limit.module.js';",
        "import { LockModule } from './core/infrastructure/redis/lock/lock.module.js';"
      ]
    },
    {
      "file": "src/app.module.ts",
      "marker": "// @infra:modules",
      "lines": ["RedisModule,", "IdempotencyModule,", "RateLimitModule,", "LockModule,"]
    },
    {
      "file": "src/core/index.ts",
      "marker": "// @infra:barrel",
      "lines": [
        "export * from './infrastructure/redis/cache.constants.js';",
        "export * from './infrastructure/redis/redis.service.js';",
        "export * from './infrastructure/redis/redis.module.js';",
        "export * from './infrastructure/redis/idempotency/idempotency.service.js';",
        "export * from './infrastructure/redis/idempotency/idempotency.module.js';",
        "export * from './infrastructure/redis/rate-limit/rate-limit.service.js';",
        "export * from './infrastructure/redis/rate-limit/rate-limit.module.js';",
        "export * from './infrastructure/redis/lock/lock.service.js';",
        "export * from './infrastructure/redis/lock/lock.module.js';",
        "export * from './http/interceptors/rate-limit.interceptor.js';",
        "export * from './http/decorators/rate-limit.decorator.js';"
      ]
    }
  ]
}
